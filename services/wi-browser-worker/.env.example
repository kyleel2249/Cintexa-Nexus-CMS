# Browser worker — run in its own container with no route to internal networks
PORT=8787
HOST=0.0.0.0
# Must equal WI_BROWSER_WORKER_TOKEN on the API host. The worker refuses unauthenticated calls when set; ALWAYS set it.
WI_BROWSER_WORKER_TOKEN=change-me-long-random-string
WI_WORKER_MAX_CONCURRENT=2
