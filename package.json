{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "node scripts/preinstall.mjs",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "dev": "pnpm --filter @workspace/cintexa dev",
    "dev:api": "pnpm --filter @workspace/api-server dev",
    "dev:all": "pnpm --parallel --filter @workspace/cintexa --filter @workspace/api-server dev",
    "build:app": "pnpm --filter @workspace/cintexa build",
    "preview": "pnpm --filter @workspace/cintexa serve"
  },
  "private": true,
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=10.0.0"
  },
  "devDependencies": {
    "prettier": "^3.8.3",
    "typescript": "~5.9.3"
  }
}
