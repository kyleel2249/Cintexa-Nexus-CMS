# ── Required ──────────────────────────────────────────────────────────────
DATABASE_URL=postgres://user:password@host:5432/cintexa
PORT=8080

# ── Auth / security ───────────────────────────────────────────────────────
# Firebase project used to verify ID tokens sent by the web app
FIREBASE_PROJECT_ID=cintexa-nexus
# Comma-separated admin e-mails. Empty = bootstrap mode (every signed-in user is admin). SET THIS IN PRODUCTION.
ADMIN_EMAILS=you@example.com
JWT_SECRET=change-me-long-random-string
# Emergency switch if an IP allow-list ever locks you out: DISABLE_IP_ALLOWLIST=1
# DISABLE_IP_ALLOWLIST=1

# ── Links (intake share links, sitemap.xml, robots.txt) ───────────────────
# Public URL of the web app, e.g. https://cintexa-nexus-cms.pages.dev  (used when the browser doesn't supply it)
PUBLIC_APP_URL=https://cintexa-nexus-cms.pages.dev
# Base URL written into sitemap.xml (your public website)
SITE_BASE_URL=https://www.example.com

# ── Optional ──────────────────────────────────────────────────────────────
JSON_BODY_LIMIT=25mb          # media is uploaded as base64
ALLOW_PRIVATE_WEBHOOKS=0      # 1 = allow webhooks to localhost / private IPs (dev only)
OPENROUTER_API_KEY=

# ── Website Intelligence Engine (all optional; unset = the dependent tests report "not configured / not tested") ──
# Google PageSpeed Insights key → measured Lighthouse lab data + CrUX field data
PAGESPEED_API_KEY=
# Isolated browser worker (services/wi-browser-worker) → rendered checks: contrast, keyboard, focus, JS errors, overflow
WI_BROWSER_WORKER_URL=
WI_BROWSER_WORKER_TOKEN=
# Label stored with audits for the vantage point of the API host, e.g. eu-west
WI_REGION=
# SMTP for audit-complete / regression notifications (otherwise notifications use in-app + webhooks only)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
SMTP_FROM=audits@example.com

# ── Sales AI Autofill: public-web research (server-side only; never exposed to the browser) ──
# Researching from a website address needs NO key. Finding a company from its NAME alone needs one search provider (first configured is tried first, the next is the fallback).
# BRAVE_SEARCH_API_KEY=
# SERPER_API_KEY=
# TAVILY_API_KEY=
# Optional limits (defaults shown)
# SALES_RESEARCH_ENABLED=true          # set to false to switch web research off for everyone
# SALES_RESEARCH_MAX_PER_HOUR=20       # per sales member
# SALES_RESEARCH_MAX_CONCURRENT=3      # researches running at once
# SALES_RESEARCH_MAX_PAGES=6           # public pages read per company (max 12)
# SALES_RESEARCH_CACHE_HOURS=24        # reuse a finished result for the same website; 0 disables
