<body>
<a class="skip-link" href="#main">Skip to content</a>

<!-- ============ HEADER ============ -->
<header class="site-header" id="site-header">
  <div class="container nav-row">
    <a href="/" class="brand" aria-label="Cintexa home">
      <img src="/assets/logo.svg" alt="" class="brand-mark" width="30" height="30">
      Cintexa
    </a>

    <nav class="nav-links" id="nav-links" aria-label="Primary">
      <a href="#services">Services</a>
      <a href="#inventory">Inventory</a>
      <a href="#intelligence">Platform</a>
      <a href="#case-studies">Case Studies</a>
      <a href="blog/">Blog</a>
      <a href="#pricing">Pricing</a>
    </nav>

    <div class="nav-actions">
      <a href="#contact" class="btn btn-ghost btn-sm">Contact</a>
      <button class="btn btn-primary btn-sm" id="open-diagnostics" type="button">Free Diagnostic</button>
    </div>

    <button class="nav-toggle" id="nav-toggle" aria-expanded="false" aria-controls="nav-links" aria-label="Toggle menu">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12h18M3 6h18M3 18h18"/></svg>
    </button>
  </div>
</header>

<main id="main">

  <!-- ============ HERO ============ -->
  <section class="hero" id="hero">
    <div class="hero-bg-dots" aria-hidden="true"></div>
    <div class="container hero-grid">

      <!-- Copy -->
      <div class="hero-copy">
        <div class="hero-trust-badges" data-hero="0">
          <span class="trust-badge">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            Enterprise-grade security
          </span>
          <span class="trust-badge">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            99.95% uptime SLA
          </span>
        </div>

        <h1 data-hero="1">
          <span class="line">Connected Technology</span>
          <span class="line">Systems That Power</span>
          <span class="line line-accent">Modern Businesses</span>
        </h1>

        <p class="hero-lede" data-hero="2">Cintexa builds intelligent software, cloud infrastructure, and business platforms that help companies automate operations, manage inventory, and scale efficiently.</p>

        <div class="hero-ctas" data-hero="3">
          <a href="#contact" class="btn btn-primary btn-lg">Build Your System</a>
          <button class="btn btn-secondary btn-lg" id="open-diagnostics-hero" type="button">Get Free Business Diagnostic</button>
        </div>

        <div class="hero-stats" data-hero="4">
          <div class="hero-stat">
            <span class="num" data-counter="40" data-suffix="%">40%</span>
            <span class="label">Avg. admin reduction</span>
          </div>
          <div class="hero-stat">
            <span class="num" data-counter="2.5" data-suffix="×">2.5×</span>
            <span class="label">Avg. conversion lift</span>
          </div>
          <div class="hero-stat">
            <span class="num" data-counter="99.95" data-suffix="%">99.95%</span>
            <span class="label">Platform uptime</span>
          </div>
        </div>
      </div>

      <!-- Dashboard Mockup -->
      <div class="hero-visual-wrap" data-hero="visual">
        <!-- Float badges -->
        <div class="hero-float-badge hero-float-badge-1">
          <div class="badge-icon" style="background:#DCFCE7;">
            <svg viewBox="0 0 24 24" fill="none" stroke="#22C55E" stroke-width="2.5"><path d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/></svg>
          </div>
          <div>
            <div style="font-size:0.7rem;color:var(--text-muted);">Revenue this month</div>
            <div style="font-size:1rem;font-weight:700;color:var(--text-primary);">$184,320 <span style="color:var(--green);font-size:0.75rem;">+23%</span></div>
          </div>
        </div>

        <div class="hero-float-badge hero-float-badge-2">
          <div class="badge-icon" style="background:#DBEAFE;">
            <svg viewBox="0 0 24 24" fill="none" stroke="#2563EB" stroke-width="2.5"><path d="M20 7H4a2 2 0 00-2 2v6a2 2 0 002 2h16a2 2 0 002-2V9a2 2 0 00-2-2z"/><circle cx="12" cy="12" r="1"/></svg>
          </div>
          <div>
            <div style="font-size:0.7rem;color:var(--text-muted);">Orders synced</div>
            <div style="font-size:1rem;font-weight:700;color:var(--text-primary);">1,248 <span style="color:var(--green);font-size:0.75rem;">live</span></div>
          </div>
        </div>

        <div class="hero-visual-frame">
          <!-- Browser chrome -->
          <div class="dash-chrome">
            <div class="dash-chrome-url">app.cintexa.com/dashboard</div>
          </div>

          <!-- Dashboard body -->
          <div class="dash-body">
            <!-- Sidebar -->
            <nav class="dash-sidebar" aria-label="Dashboard navigation">
              <div class="dash-sidebar-icon is-active">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
              </div>
              <div class="dash-sidebar-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 7H4a2 2 0 00-2 2v6a2 2 0 002 2h16a2 2 0 002-2V9a2 2 0 00-2-2z"/></svg>
              </div>
              <div class="dash-sidebar-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2M9 11a4 4 0 100-8 4 4 0 000 8z"/></svg>
              </div>
              <div class="dash-sidebar-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 3v18h18M7 14l4-4 3 3 5-6"/></svg>
              </div>
              <div class="dash-sidebar-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              </div>
            </nav>

            <!-- Main content -->
            <div class="dash-main">
              <!-- KPI row -->
              <div class="dash-kpis">
                <div class="dash-kpi">
                  <div class="dash-kpi-label">Revenue</div>
                  <div class="dash-kpi-val">$184K</div>
                  <div class="dash-kpi-delta">▲ 23%</div>
                </div>
                <div class="dash-kpi">
                  <div class="dash-kpi-label">Orders</div>
                  <div class="dash-kpi-val">1,248</div>
                  <div class="dash-kpi-delta">▲ 11%</div>
                </div>
                <div class="dash-kpi">
                  <div class="dash-kpi-label">Customers</div>
                  <div class="dash-kpi-val">3,891</div>
                  <div class="dash-kpi-delta">▲ 8%</div>
                </div>
                <div class="dash-kpi">
                  <div class="dash-kpi-label">Uptime</div>
                  <div class="dash-kpi-val">99.9%</div>
                  <div class="dash-kpi-delta" style="color:var(--green);">● Live</div>
                </div>
              </div>

              <!-- Mid row -->
              <div class="dash-mid">
                <!-- Bar chart -->
                <div class="dash-chart-card">
                  <div class="dash-chart-title">Monthly Sales Performance</div>
                  <div class="dash-bars">
                    <div class="dash-bar" style="height:45%"></div>
                    <div class="dash-bar" style="height:62%"></div>
                    <div class="dash-bar" style="height:51%"></div>
                    <div class="dash-bar" style="height:78%"></div>
                    <div class="dash-bar" style="height:65%"></div>
                    <div class="dash-bar" style="height:88%"></div>
                    <div class="dash-bar" style="height:72%"></div>
                    <div class="dash-bar" style="height:95%"></div>
                    <div class="dash-bar" style="height:83%"></div>
                    <div class="dash-bar" style="height:100%"></div>
                  </div>
                </div>

                <!-- Inventory -->
                <div class="dash-inv-card">
                  <div class="dash-inv-title">Inventory Status</div>
                  <div class="dash-inv-row">
                    <span class="dash-inv-row-name">Product A</span>
                    <span class="dash-inv-row-stock">842 units</span>
                  </div>
                  <div class="dash-inv-row">
                    <span class="dash-inv-row-name">Product B</span>
                    <span class="dash-inv-row-stock low">12 units</span>
                  </div>
                  <div class="dash-inv-row">
                    <span class="dash-inv-row-name">Product C</span>
                    <span class="dash-inv-row-stock">291 units</span>
                  </div>
                  <div class="dash-inv-row">
                    <span class="dash-inv-row-name">Product D</span>
                    <span class="dash-inv-row-stock">1,104 units</span>
                  </div>
                </div>
              </div>

              <!-- Intelligence chips -->
              <div class="dash-intel-row">
                <div class="dash-intel-chip">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/></svg>
                  Reorder Product B — stock critical
                </div>
                <div class="dash-intel-chip">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/></svg>
                  Q4 demand up 34% — forecast ready
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ BUSINESS PROBLEMS ============ -->
  <section class="section problems-section" id="problems">
    <div class="container">
      <div class="section-head centered" data-reveal>
        <span class="eyebrow">The real cost of disconnected systems</span>
        <h2>Every day without connected technology costs your business</h2>
        <p>Most businesses lose time, revenue, and customers to fragmented tools, manual processes, and outdated infrastructure. Cintexa solves this.</p>
      </div>

      <div class="problems-grid">
        <div class="problem-card" data-reveal data-delay="1">
          <div class="problem-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 9v2m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/></svg>
          </div>
          <h3>Inventory chaos costing you customers</h3>
          <p>Overselling, stockouts, and manual tracking across spreadsheets leads to delayed orders, unhappy customers, and lost revenue you never recover.</p>
          <div class="problem-arrow">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            Cintexa Inventory fixes this
          </div>
        </div>

        <div class="problem-card" data-reveal data-delay="2">
          <div class="problem-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 9v2m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/></svg>
          </div>
          <h3>Manual operations burning your team's time</h3>
          <p>Hours wasted on repetitive data entry, disconnected tools, and manual reporting that should be automated — pulling your team away from real work.</p>
          <div class="problem-arrow">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            Business automation solves this
          </div>
        </div>

        <div class="problem-card" data-reveal data-delay="3">
          <div class="problem-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 9v2m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/></svg>
          </div>
          <h3>Technology holding back your growth</h3>
          <p>Legacy software, slow websites, and infrastructure that can't scale are silent competitors — they make you lose deals before you even know you're in them.</p>
          <div class="problem-arrow">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            Our platform transforms this
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ SOLUTIONS ============ -->
  <section class="section" id="services">
    <div class="container">
      <div class="section-head" data-reveal>
        <span class="eyebrow">What we build</span>
        <h2>A complete technology ecosystem for your business</h2>
        <p>From custom software to the cloud infrastructure that runs it — every Cintexa service is built to integrate, not sit in isolation.</p>
      </div>

      <div class="solutions-grid">
        <div class="solution-card" data-reveal data-delay="1">
          <div class="solution-icon"><svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke="currentColor"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg></div>
          <h3>Inventory Management</h3>
          <p>Real-time stock tracking, automated alerts, multi-location control, and demand forecasting — built for growing businesses.</p>
          <a href="#inventory" class="solution-link">Explore inventory <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
        </div>

        <div class="solution-card" data-reveal data-delay="2">
          <div class="solution-icon"><svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke="currentColor"><path d="M16 18l6-6-6-6M8 6l-6 6 6 6"/></svg></div>
          <h3>Custom Software</h3>
          <p>Bespoke applications, internal tools, CRMs, and dashboards built around your operating model — not a generic template.</p>
          <a href="#software" class="solution-link">See software services <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
        </div>

        <div class="solution-card" data-reveal data-delay="3">
          <div class="solution-icon"><svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke="currentColor"><path d="M3 15a4 4 0 014-4h.5a5.5 5.5 0 0110.9-1A4.5 4.5 0 0118.5 19H7a4 4 0 01-4-4z"/></svg></div>
          <h3>Cloud Infrastructure</h3>
          <p>Resilient, edge-accelerated infrastructure on Firebase and Cloudflare — provisioned for uptime, scale, and predictable cost.</p>
          <a href="#cloud" class="solution-link">Review architecture <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
        </div>

        <div class="solution-card" data-reveal data-delay="4">
          <div class="solution-icon"><svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke="currentColor"><path d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/></svg></div>
          <h3>Business Intelligence</h3>
          <p>Automated reporting, predictive insights, workflow automation, and smart recommendations that keep your business ahead.</p>
          <a href="#intelligence" class="solution-link">Learn more <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
        </div>

        <div class="solution-card" data-reveal data-delay="5">
          <div class="solution-icon"><svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke="currentColor"><path d="M8 9l-4 3 4 3M16 9l4 3-4 3M13 5l-2 14"/></svg></div>
          <h3>API &amp; Integrations</h3>
          <p>Clean, documented API layers that connect your existing tools instead of forcing a rebuild — live in our Developer Portal.</p>
          <a href="#developer-portal" class="solution-link">Open developer portal <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
        </div>

        <div class="solution-card" data-reveal data-delay="6">
          <div class="solution-icon"><svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke="currentColor"><path d="M3 3v18h18M7 14l4-4 3 3 5-6"/></svg></div>
          <h3>Digital Transformation</h3>
          <p>Structured roadmaps that move legacy operations onto connected systems — sequenced so your business never stalls mid-migration.</p>
          <a href="#diagnostics" class="solution-link">Run a free diagnostic <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ INVENTORY MANAGEMENT ============ -->
  <section class="section inventory-section" id="inventory">
    <div class="container inventory-layout">
      <!-- Copy -->
      <div class="inventory-copy" data-reveal>
        <span class="eyebrow">Smart Inventory Management</span>
        <h2>Built for growing businesses that can't afford stockouts</h2>
        <p class="inv-desc">Stop losing customers to inventory chaos. Cintexa's inventory platform gives you real-time visibility, automation, and predictive intelligence across every location, channel, and supplier.</p>

        <div class="inv-features">
          <div class="inv-feature">
            <div class="inv-feature-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6L9 17l-5-5"/></svg></div>
            <span>Real-time stock tracking</span>
          </div>
          <div class="inv-feature">
            <div class="inv-feature-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6L9 17l-5-5"/></svg></div>
            <span>Automated reorder alerts</span>
          </div>
          <div class="inv-feature">
            <div class="inv-feature-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6L9 17l-5-5"/></svg></div>
            <span>Barcode &amp; SKU management</span>
          </div>
          <div class="inv-feature">
            <div class="inv-feature-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6L9 17l-5-5"/></svg></div>
            <span>Multi-location control</span>
          </div>
          <div class="inv-feature">
            <div class="inv-feature-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6L9 17l-5-5"/></svg></div>
            <span>Demand forecasting</span>
          </div>
          <div class="inv-feature">
            <div class="inv-feature-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6L9 17l-5-5"/></svg></div>
            <span>Supplier management</span>
          </div>
          <div class="inv-feature">
            <div class="inv-feature-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6L9 17l-5-5"/></svg></div>
            <span>Analytics dashboard</span>
          </div>
          <div class="inv-feature">
