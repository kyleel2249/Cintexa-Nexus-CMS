  <div class="diag-modal" id="diag-modal">
    <div class="diag-modal-header">
      <div class="diag-progress-track"><div class="diag-progress-fill" id="diag-progress-fill"></div></div>
      <span class="diag-progress-label" id="diag-progress-label">Step 0 / 0</span>
      <button class="diag-modal-close" id="diag-close" aria-label="Close diagnostics">✕</button>
    </div>
    <div class="diag-modal-body" id="diag-body"></div>
    <div class="diag-modal-footer" id="diag-footer"></div>
  </div>
</div>

