rules_version = '2';

/**
 * Evidence / attachment storage (screenshots, raw scanner output files,
 * report exports a user chooses to re-upload, etc). Files are stored under
 * /tenants/{tenantId}/... and access is scoped to members of that tenant
 * via the same custom claims Firestore rules use.
 */
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }
    function sameTenant(tenantId) {
      return isSignedIn() && request.auth.token.tenantId == tenantId;
    }
    function hasRole(minRole) {
      let rank = { 'owner': 5, 'admin': 4, 'analyst': 3, 'tester': 2, 'viewer': 1 };
      return isSignedIn() && rank[request.auth.token.role] >= rank[minRole];
    }

    match /tenants/{tenantId}/evidence/{allPaths=**} {
      allow read: if sameTenant(tenantId);
      allow write: if sameTenant(tenantId) && hasRole('analyst')
        && request.resource.size < 25 * 1024 * 1024
        && request.resource.contentType.matches('image/.*|application/pdf|application/json|text/.*');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
